# Copy this file to .env.local for local development
# (or set these as environment variables in your hosting provider).

# --- Required ---

# Used to sign auth session tokens. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string

# The base URL where this app is reachable. Used to build links in emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database ---
# Path to the SQLite database file. On most hosts (Railway, Render, Fly, a VPS)
# mount a persistent volume and point this at it. Defaults to ./data/inviteaz.db
# DATABASE_FILE=/data/inviteaz.db

# --- Email (optional) ---
# Without these, InvitEaz logs emails to the server console instead of sending
# them — handy for trying the whole product out before you wire up SMTP.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=your-smtp-password
# EMAIL_FROM="InvitEaz <notifications@yourdomain.com>"

# --- SMS (optional) ---
# Without these, InvitEaz logs texts to the server console instead of sending
# them — handy for trying the whole product out before you wire up Twilio.
# Note: a Twilio trial account can only text phone numbers you've verified in
# the Twilio console — add a payment method to send to arbitrary numbers.
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+15551234567

# --- Automated reminders (optional) ---
# If set, protects /api/cron/reminders — pass it as an x-cron-secret header
# or ?secret= query param when you call it from your scheduler.
# CRON_SECRET=replace-with-a-random-string
